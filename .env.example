# PostgreSQL local development only
POSTGRES_DB=sofia
POSTGRES_USER=sofia
POSTGRES_PASSWORD=sofia_local
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sofia:sofia_local@127.0.0.1:5433/sofia?schema=public

# Applications
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
TZ=America/Sao_Paulo

# JWT verification. The public key is an example with no committed private key.
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=https://auth.local.sofia.test
AUTH_JWT_AUDIENCE=sofia-api
AUTH_JWT_PUBLIC_KEY_
