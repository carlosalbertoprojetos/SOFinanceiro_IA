# PostgreSQL local development only
POSTGRES_DB=sofia
POSTGRES_USER=sofia
POSTGRES_PASSWORD=sofia_local
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sofia:sofia_local@127.0.0.1:5433/sofia?schema=public

# Applications
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
TZ=America/Sao_Paulo

# Auth0 development tenant. Keep values empty until copied to an untracked .env.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_ISSUER=
AUTH0_AUDIENCE=https://api.sofia.local
AUTH0_JWKS_CACHE_TTL_SECONDS=600
AUTH0_JWKS_STALE_TTL_SECONDS=3600
